# ==============================================================================
# PrepVerse AI — Backend Environment Configuration Template
# Copy this file to .env and customize values for your local environment.
# Never commit the actual .env file with production credentials.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="PrepVerse AI"
TAGLINE="Prepare Smarter. Practice Deeper. Become Interview-Ready."
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite / PostgreSQL)
# Local SQLite default:
DATABASE_URL=sqlite:///./prepverse_dev.db
# PostgreSQL option:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prepverse_dev

# Security & Authentication Settings
JWT_SECRET_KEY=prepverse-local-development-secret-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
ADMIN_PASSCODE=PrepVerseAdmin2026!

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=5242880

# AI Provider Settings
# Options: deterministic (default, offline, zero API key needed), gemini
AI_PROVIDER=deterministic
GEMINI_API_KEY=

# CORS Settings (JSON-encoded array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]
