# ==============================================================================
# PrepVerse AI — Environment Configuration Template
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
PROJECT_NAME="PrepVerse AI"
TAGLINE="Prepare Smarter. Practice Deeper. Become Interview-Ready."
DEBUG=True

# API Configuration
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Configuration:
# 1. Zero-config local SQLite (Default for quick demo):
DATABASE_URL=sqlite:///./prepverse_dev.db
# 2. Production PostgreSQL (Uncomment to use PostgreSQL):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/interviewai_dev

# Security & Authentication (JWT)
JWT_SECRET_KEY=prepverse-local-development-secret-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# File Upload Limits (Bytes) - 5 MB default
MAX_UPLOAD_SIZE_BYTES=5242880

# AI Engine Provider:
# Options: "deterministic" (Local, offline, zero API key needed), "gemini" (Requires GEMINI_API_KEY)
AI_PROVIDER=deterministic
# GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

